{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["react", "import"],
  "rules": {
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": ["**/kits/*/[A-Z]*", "kits/*/[A-Z]*"],
            "message": "Import design-system components from the kit's index.js, not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var() or rem."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Suisse Int'l))/i]",
        "message": "Font not provided by the design system. Available: Suisse Int'l."
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/index.js"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": ["**/kits/vuetify/*.js", "**/*theme*.js"],
      "rules": { "no-restricted-syntax": "off" }
    }
  ]
}
